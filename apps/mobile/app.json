{
  "expo": {
    "name": "Tollgate",
    "slug": "tollgate",
    "scheme": "tollgate",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "xyz.trytollgate.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Tollgate uses Face ID so that only you can approve a payment or unfreeze your agents."
      }
    },
    "android": {
      "package": "xyz.trytollgate.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Tollgate uses Face ID so that only you can approve a payment or unfreeze your agents."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 104,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Tollgate uses the camera only to scan the pairing code on your dashboard.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png"
  }
}
