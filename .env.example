# Tollgate settings.
#
# `pnpm onboard` creates .env from this file and fills in every blank for you (random passwords, the database address, the signing key).
# It never overwrites a value you have set. So the easy way to use this file is: do not edit it, run `pnpm onboard`.
#
# .env is git-ignored and must never be committed. Do NOT put private keys in it: the signer reads its key from a file (SIGNER_KEY_FILE).

# ---- Database: a local Postgres in Docker (start it with `pnpm db:up`) --------------------------------------------------
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
# How the gateway and the signer reach the database. onboard builds this from the two lines above.
# To use your own Postgres instead, set it yourself: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
# DATABASE_SCHEMA=              optional: keep the tables in their own schema (lowercase letters, digits and _)

# ---- Gateway ---------------------------------------------------------------------------------------------------------------
# The owner's password for the gateway and the dashboard. At least 16 characters.
GATEWAY_OPERATOR_TOKEN=
# true: answer from recorded 1Click responses (no key, no network, no money). false: talk to the live 1Click (needs NEAR_1CLICK_API_KEY).
TOLLGATE_OFFLINE=true
# PORT=8787
# LOG_LEVEL=info                 silent | info | debug
# APPROVAL_TTL_MINUTES=1440      how long a payment waits for the owner before it expires

# ---- Signer (a separate program that holds the only key) --------------------------------------------------------------------
SIGNER_URL=http://127.0.0.1:8788
# What the gateway shows the signer to prove who it is. At least 32 characters; the same value is used by both.
SIGNER_SERVICE_TOKEN=
# The file holding the signing key. onboard fills this in and makes a throwaway key there (mode 600, git-ignored).
SIGNER_KEY_FILE=
# The signer's own limits, whatever any mandate says:
# SIGNER_PORT=8788
# SIGNER_CHAINS=eip155:42161     which chains it will pay on
# SIGNER_MAX_PER_TX=1.00         the most it will sign in one payment, in USDC

# ---- Optional keys: nothing above needs them ----------------------------------------------------------------------------------
# NEAR Intents 1Click key. Only used when TOLLGATE_OFFLINE=false. Sent only as the X-API-Key header to 1click.chaindefuser.com.
NEAR_1CLICK_API_KEY=
# Paying FROM NEAR (optional). Add `near` to the signer's chains, e.g. SIGNER_CHAINS=eip155:42161,near, then make a key with
# `pnpm --filter @tollgate/signer keygen-near` (it prints only the public account and key). Fund that account before any real payment.
# SIGNER_CHAINS=eip155:42161
# SIGNER_NEAR_KEY_FILE=.signer-near-key
# SIGNER_NEAR_ACCOUNT=                  a named account the key belongs to; empty = the key's own implicit account
# The reference services (pnpm services): a real merchant, seller and worker that call the live 1Click API.
# MERCHANT_NEAR_ACCOUNT: the NEAR account that should RECEIVE payment. Yours to choose: nothing guesses it. Needs NEAR_1CLICK_API_KEY above.
MERCHANT_NEAR_ACCOUNT=
# Signs the prices the reference seller agrees to. At least 16 characters. `pnpm onboard` generates it.
WORKERS_DEAL_SECRET=
# WORKERS_PORT=9200
# WORKERS_PRICE_OPENING=0.30
# WORKERS_PRICE_FLOOR=0.20
# Optional: lets `pnpm demo --llm` use a Claude model to plan the agent's negotiation. Never commit it.
ANTHROPIC_API_KEY=
# PLANNER_MODEL=claude-opus-5-5
# NEAR AI Cloud key. Reserved for an LLM-driven demo agent; nothing reads it yet.
NEAR_AI_API_KEY=
