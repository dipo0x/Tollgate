# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Gateway ---
NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://tollgate:tollgate@localhost:5432/tollgate
LOG_LEVEL=info

# Offline mode replays recorded fixtures: no network, no funds. Default for bench and CI.
TOLLGATE_OFFLINE=true

# --- Signer (separate process; never exposed to the network) ---
SIGNER_SOCKET=/tmp/tollgate-signer.sock
# Hex private key for the small signer float. Leave empty unless running a live payment.
SIGNER_PRIVATE_KEY=
# Hard ceiling on the float, in USDC. The signer refuses to start above this.
SIGNER_FLOAT_CAP_USDC=30

# --- NEAR Intents / 1Click ---
ONECLICK_BASE_URL=https://1click.chaindefuser.com
# Optional. Without a key 1Click charges 0.2%; with one, only the 0.0001% protocol fee.
ONECLICK_JWT=

# --- NEAR ---
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=

# --- EVM origin (MVP wallet path: USDC on Arbitrum) ---
ARBITRUM_RPC_URL=
EVM_PRIVATE_KEY=

# --- NEAR AI Cloud (demo agent reasoning, TEE inference) ---
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=
NEAR_AI_MODEL=

# --- Dashboard ---
DASHBOARD_SESSION_SECRET=
VITE_GATEWAY_URL=http://localhost:8787
