# Tollgate settings.
#
# `pnpm onboard` creates .env from this file and fills in every blank for you (random passwords, the database address, the signing key).
# It never overwrites a value you have set. So the easy way to use this file is: do not edit it, run `pnpm onboard`.
#
# .env is git-ignored and must never be committed. Do NOT put private keys in it: the signer reads its key from a file (SIGNER_NEAR_KEY_FILE).

# ---- Database: a local Postgres in Docker (start it with `pnpm db:up`) --------------------------------------------------
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
# How the gateway and the signer reach the database. onboard builds this from the two lines above.
# To use your own Postgres instead, set it yourself: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
# DATABASE_SCHEMA=              optional: keep the tables in their own schema (lowercase letters, digits and _)
# DATABASE_POOL_MAX=10          optional: most connections the gateway holds. Hosted plans are small (Aiven: 17 for everyone); pnpm all and pnpm live:app use 4

# ---- Gateway ---------------------------------------------------------------------------------------------------------------
# The owner's password for the gateway and the dashboard. At least 16 characters.
GATEWAY_OPERATOR_TOKEN=
# true: answer from recorded 1Click responses (no key, no network, no money). false: talk to the live 1Click (needs NEAR_1CLICK_API_KEY).
TOLLGATE_OFFLINE=true
# PORT=8787
# GATEWAY_HOST=127.0.0.1         who may connect. 127.0.0.1: this computer only (default). 0.0.0.0: your Wi-Fi too, needed to
#                                pair the Tollgate phone app. Every call still needs a token; use only on a network you trust.
# LOG_LEVEL=info                 silent | info | debug
# APPROVAL_TTL_MINUTES=1440      how long a payment waits for the owner before it expires
# Seals photos attached in the phone chat (AES-256-GCM): 32 random bytes, base64. Empty = photos off. Make one: openssl rand -base64 32
GATEWAY_ATTACHMENT_KEY=

# ---- Signer (a separate program that holds the only key) --------------------------------------------------------------------
SIGNER_URL=http://127.0.0.1:8788
# What the gateway shows the signer to prove who it is. At least 32 characters; the same value is used by both.
SIGNER_SERVICE_TOKEN=
# The file holding the signing key. onboard fills this in and makes a key there (mode 600, git-ignored).
SIGNER_NEAR_KEY_FILE=
# The signer's own limits, whatever any mandate says:
# SIGNER_PORT=8788
# SIGNER_CHAINS=near,near:mainnet   which NEAR payment paths it signs: near (1Click) and near:mainnet (the agent market).
# SIGNER_MAX_PER_TX=1.00         the most it will sign in one payment, in USDC

# ---- Optional keys: nothing above needs them ----------------------------------------------------------------------------------
# NEAR Intents 1Click key. Only used when TOLLGATE_OFFLINE=false. Sent only as the X-API-Key header to 1click.chaindefuser.com.
NEAR_1CLICK_API_KEY=
# Paying FROM NEAR (`pnpm onboard` makes the key). To make one by hand:
# `pnpm --filter @tollgate/signer keygen-near` (it prints only the public account and key). Fund that account before any real payment.
# SIGNER_NEAR_ACCOUNT=                  a named account the key belongs to; empty = the key's own implicit account
# Withdrawing your USDC back out (the Withdraw screen in the app). The ONE NEAR account it may go to. Set it here, on the signer's computer:
# the app and the gateway can choose an amount but never a destination. Empty = withdrawals are off.
SIGNER_WITHDRAW_TO=
# The most one withdrawal may move, in USDC. Empty = no cap (the money can only go to the account above).
SIGNER_MAX_WITHDRAW=
# The reference services (pnpm services): a real merchant, seller and worker that call the live 1Click API.
# MERCHANT_NEAR_ACCOUNT: the NEAR account that should RECEIVE payment. Yours to choose: nothing guesses it. Needs NEAR_1CLICK_API_KEY above.
MERCHANT_NEAR_ACCOUNT=
# Signs the prices the reference seller agrees to. At least 16 characters. `pnpm onboard` generates it.
WORKERS_DEAL_SECRET=
# WORKERS_PORT=9200
# WORKERS_PRICE_OPENING=0.30
# WORKERS_PRICE_FLOOR=0.20
# Optional: `pnpm demo --llm` lets a model decide for the agent. Default: Ollama on this computer (ollama pull qwen2.5:7b), no key needed.
# OLLAMA_URL=http://127.0.0.1:11434
# PLANNER_MODEL=qwen2.5:7b
# To use Claude instead: PLANNER_PROVIDER=anthropic, PLANNER_MODEL=claude-opus-5-5 and a key below. Never commit the key.
# PLANNER_PROVIDER=ollama
ANTHROPIC_API_KEY=
# NEAR AI Cloud is a brain for phone agents: NEARAI_API_KEY and NEARAI_MODEL, below.

# Brains for agents made in the phone app (pnpm live:app). Each key you set here adds that brain to the "Who answers" list in the app.
# Keys stay on this computer: the phone and the gateway are only ever told the brain's name. Leave empty what you do not use.
#   Claude: ANTHROPIC_API_KEY above (model: AGENT_MODEL, default claude-opus-5-5).   Local model: Ollama above (AGENT_OLLAMA_MODEL).
XAI_API_KEY=
# XAI_MODEL=grok-4              Grok (xAI). Set the model your account has.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini      ChatGPT (OpenAI).
NEARAI_API_KEY=
# NEARAI_MODEL=                 NEAR AI Cloud. Required with the key: there is no default, the catalogue changes.
# Your own agent or any server that speaks the OpenAI "chat completions" API (LM Studio, vLLM, llama.cpp, a script on localhost).
# A JSON list; keyEnv NAMES the variable holding its key (omit for a server with no key), so no secret is written here:
# AGENT_BRAINS=[{"id":"mine","label":"My agent","baseUrl":"http://localhost:8000/v1","model":"my-model","keyEnv":"MINE_KEY"}]
# An agent that runs on its OWN program (not on this computer) needs none of this: choose "My own agent" in the app and copy its key.
# Only if you run the gateway apart from pnpm live:app and want a host for hosted agents: a key for the host, different from the owner's.
# GATEWAY_RUNNER_TOKEN=         openssl rand -base64 32
# NEAR_RPC_URL=https://free.rpc.fastnear.com   optional: the NEAR RPC provider for live runs (balances, nonce, broadcast). Default FastNEAR.

# Market seller listing (earn). Token is shown once at registration.
MARKET_SELLER_HANDLE=
MARKET_SELLER_TOKEN=
GATEWAY_URL=http://127.0.0.1:8787
