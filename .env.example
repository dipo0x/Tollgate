# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Gateway ---
NODE_ENV=development
PORT=8787
# Local Postgres from docker-compose.yml. Choose any password and use the same one in both lines.
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
DATABASE_URL=postgres://tollgate:<same password>@localhost:5433/tollgate
# Required by the gateway: it keeps all of its state in Postgres and nothing in the process.
# DATABASE_SCHEMA=   optional: keep this gateway's tables in their own schema (lowercase).
LOG_LEVEL=info

# Offline mode replays recorded fixtures: no network, no funds. Default for bench and CI.
TOLLGATE_OFFLINE=true

# Owner-level token for the gateway (at least 16 characters). Generate one: openssl rand -hex 24
GATEWAY_OPERATOR_TOKEN=

# --- Signer (separate process; never exposed to the network) ---
SIGNER_SOCKET=/tmp/tollgate-signer.sock
# Hex private key for the small signer float. Leave empty unless running a live payment.
SIGNER_PRIVATE_KEY=
# Hard ceiling on the float, in USDC. The signer refuses to start above this.
SIGNER_FLOAT_CAP_USDC=30

# --- NEAR Intents / 1Click ---
ONECLICK_BASE_URL=https://1click.chaindefuser.com
# Optional. Without a key 1Click charges 0.2%; with one, only the 0.0001% protocol fee.
# Sent only as the X-API-Key header, and stripped from every recorded fixture.
NEAR_1CLICK_API_KEY=

# --- NEAR ---
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=

# --- EVM origin (MVP wallet path: USDC on Arbitrum) ---
ARBITRUM_RPC_URL=
EVM_PRIVATE_KEY=

# --- NEAR AI Cloud (demo agent reasoning, TEE inference) ---
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=
NEAR_AI_MODEL=

# --- Dashboard ---
DASHBOARD_SESSION_SECRET=
VITE_GATEWAY_URL=http://localhost:8787
