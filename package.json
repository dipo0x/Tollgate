{
  "name": "tollgate",
  "private": true,
  "version": "0.1.0",
  "description": "Tollgate: a payment firewall that sits between an AI agent and its wallet. Monorepo for the gateway, signer, SDK, dashboard, demo agent, benchmark and site.",
  "author": "Oladipo Adesiyan",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "all": "node scripts/dev-all.mjs",
  "dev": "node scripts/preflight.mjs --quick && pnpm -r --parallel --stream dev",
    "site": "pnpm --filter @tollgate/site dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node --test scripts/*.test.mjs",
    "lint": "pnpm -r lint",
    "bench": "pnpm --filter @tollgate/bench start",
    "demo": "pnpm --filter @tollgate/demo-agent start",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v",
    "e2e": "pnpm --filter trytollgate build && pnpm --filter @tollgate/e2e start",
    "onboard": "node scripts/onboard.mjs",
    "preflight": "node scripts/preflight.mjs",
    "live": "pnpm --filter @tollgate/e2e live",
    "services": "pnpm --filter @tollgate/workers start",
    "sandbox": "pnpm --filter trytollgate build && pnpm --filter @tollgate/e2e sandbox",
    "sandbox:agent": "pnpm --silent --filter @tollgate/e2e agent",
    "sandbox:phone": "pnpm --filter trytollgate build && pnpm --filter @tollgate/e2e sandbox --phone",
    "prepare": "pnpm --filter trytollgate build",
    "live:near": "pnpm --filter @tollgate/e2e live:near",
    "live:mandate": "pnpm --filter @tollgate/e2e live:mandate",
    "spend": "pnpm --silent --filter @tollgate/e2e spend",
    "mobile": "pnpm --filter @tollgate/mobile ios",
    "live:market": "pnpm --filter @tollgate/e2e live:market"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
