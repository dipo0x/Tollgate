# dependencies
node_modules/
.pnpm-store/

# builds
dist/
build/
*.tsbuildinfo

# env and secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key

# test and bench output
coverage/
*.local

# editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# lockfiles from other package managers (this repo uses pnpm)
package-lock.json
yarn.lock

# vite dep-optimizer cache
.vite/

# submission payload holds personal data — never commit
payload.json

# local runtime data (audit logs etc.)
.data/

# The signer's key file. Never commit a key.
.signer-key*
*.key

# The running sandbox's addresses and throwaway tokens.
.sandbox.json

# The signer's NEAR key (ed25519). Never committed.
.signer-near-key*
.near-pay-confirm
.near-pay-result.json
.spend-result.json
# Satoshi (ITF Free Font License): may be embedded in the app, may NOT be redistributed from a repository.
# apps/mobile/scripts/get-fonts.mjs fetches it from Fontshare before the app starts.
apps/mobile/assets/fonts/Satoshi-*.otf
.market-pay-confirm
.live-agent.json
.vercel
